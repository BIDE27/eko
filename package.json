{
  "name": "eko-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @eko/web dev",
    "build:web": "pnpm --filter @eko/web build",
    "dev:mobile": "pnpm --filter @eko/mobile start",
    "build:core": "pnpm --filter @eko/core build",
    "dev": "pnpm --filter @eko/web dev",
    "build": "pnpm --filter @eko/web build"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}


